    {
      "article_no": "27",
      "article_title": "\uad6d\uc678\uc774\uc8fc \ubaa9\uc801 \uc678\uc758 \ud5c8\uac00 \ucde8\uc18c",
      "law_name": "\ubcd1\uc5ed\uc758\ubb34\uc790 \uad6d\uc678\uc5ec\ud589 \uc5c5\ubb34\ucc98\ub9ac \uaddc\uc815",
      "paragraph_no": "3",
      "score": 0.5618,
      "text": "[\ubcd1\uc5ed\uc758\ubb34\uc790 \uad6d\uc678\uc5ec\ud589 \uc5c5\ubb34\ucc98\ub9ac \uaddc\uc815 \uc81c27\uc870(\uad6d\uc678\uc774\uc8fc \ubaa9\uc801 \uc678\uc758 \ud5c8\uac00 \ucde8\uc18c) \uc81c3\ud56d]\n\u2462 \uc9c0\ubc29\ubcd1\ubb34\uccad\uc7a5\uc740 \uc720\ud559 \ubaa9\uc801\uc73c\ub85c \uad6d\uc678\uc5ec\ud589\ud5c8\uac00\ub97c \ubc1b\uc740 \uc0ac\ub78c\uc5d0 \ub300\ud558\uc5ec \uc81c9\uc870\uc81c2\ud638\uc5d0 \ub530\ub978 \uc7ac\ud559\uc0ac\uc2e4\uc744 \ud655\uc778\ud55c\uacb0\uacfc \ud5c8\uac00\uc694\uac74\uc744 \uc720\uc9c0\ud558\uc9c0 \ubabb\ud55c \uacbd\uc6b0\uc5d0\ub294 \uc601 \uc81c147\uc870\uc7582\uc81c1\ud56d\uc81c5\ud638\uc5d0 \ub530\ub77c \ud5c8\uac00\ub97c \ucde8\uc18c\ud558\uace0 \uadf8 \uc0ac\uc2e4\uc744 \ubcf8\uc778\uc5d0\uac8c \ud1b5\uc9c0\ud558\uc5ec\uc57c \ud55c\ub2e4."
    },
    {
      "article_no": "27",
      "article_title": "\uad6d\uc678\uc774\uc8fc \ubaa9\uc801 \uc678\uc758 \ud5c8\uac00 \ucde8\uc18c",
      "law_name": "\ubcd1\uc5ed\uc758\ubb34\uc790 \uad6d\uc678\uc5ec\ud589 \uc5c5\ubb34\ucc98\ub9ac \uaddc\uc815",
      "paragraph_no": "1",
      "score": 0.5509,
      "text": "[\ubcd1\uc5ed\uc758\ubb34\uc790 \uad6d\uc678\uc5ec\ud589 \uc5c5\ubb34\ucc98\ub9ac \uaddc\uc815 \uc81c27\uc870(\uad6d\uc678\uc774\uc8fc \ubaa9\uc801 \uc678\uc758 \ud5c8\uac00 \ucde8\uc18c) \uc81c1\ud56d]\n\u2460 \uc9c0\ubc29\ubcd1\ubb34\uccad\uc7a5\uc740 \uad6d\uc678\uc774\uc8fc \uc678\uc758 \ubaa9\uc801\uc73c\ub85c \uad6d\uc678\uc5ec\ud589\ud5c8\uac00\ub97c \ubc1b\uc740 \uc0ac\ub78c\uc774 \uc815\ub2f9\ud55c \uc0ac\uc720 \uc5c6\uc774 \ud5c8\uac00\uae30\uac04 \uc2dc\uc791\uc77c\ubd80\ud130 11\uac1c\uc6d4\uc774 \uc9c0\ub098\ub3c4\ub85d \ucd9c\uad6d\ud558\uc9c0 \uc544\ub2c8\ud55c \uacbd\uc6b0\uc5d0\ub294 \ud5c8\uac00 \ucde8\uc18c\uc5d0 \ub300\ud55c \uc0ac\uc804 \uc548\ub0b4\ub97c \ubcf8\uc778 \ub610\ub294 \uac00\uc871\uc5d0\uac8c \ud558\uc5ec\uc57c \ud558\uba70, 12\uac1c\uc6d4\uc774 \uc9c0\ub098\ub3c4 \ucd9c\uad6d\ud558\uc9c0 \uc544\ub2c8\ud55c \uacbd\uc6b0\uc5d0\ub294 \uc601 \uc81c147\uc870\uc7582\uc81c1\ud56d\uc81c3\ud638 \uc804\ub2e8\uc5d0 \ub530\ub77c \ud5c8\uac00\ub97c \ucde8\uc18c\ud558\uace0 \uadf8 \uc0ac\uc2e4\uc744 \ubcf8\uc778\uc5d0\uac8c \ud1b5\uc9c0\ud558\uc5ec\uc57c \ud55c\ub2e4."
    },
    {
      "article_no": "27",
      "article_title": "\uad6d\uc678\uc774\uc8fc \ubaa9\uc801 \uc678\uc758 \ud5c8\uac00 \ucde8\uc18c",
      "law_name": "\ubcd1\uc5ed\uc758\ubb34\uc790 \uad6d\uc678\uc5ec\ud589 \uc5c5\ubb34\ucc98\ub9ac \uaddc\uc815",
      "paragraph_no": "4",
      "score": 0.5504,
      "text": "[\ubcd1\uc5ed\uc758\ubb34\uc790 \uad6d\uc678\uc5ec\ud589 \uc5c5\ubb34\ucc98\ub9ac \uaddc\uc815 \uc81c27\uc870(\uad6d\uc678\uc774\uc8fc \ubaa9\uc801 \uc678\uc758 \ud5c8\uac00 \ucde8\uc18c) \uc81c4\ud56d]\n\u2463 \uc9c0\ubc29\ubcd1\ubb34\uccad\uc7a5\uc740 \uad6d\uc678\uc5ec\ud589\ud5c8\uac00\ub97c \ubc1b\uc740 \uc0ac\ub78c\uc774 \ud5c8\uac00\uae30\uac04\uc774 \ub9cc\ub8cc\ub418\uae30 \uc804\uc5d0 \uc2b9\uc120\uadfc\ubb34\uc608\ube44\uc5ed, \uc0b0\uc5c5\uae30\ub2a5\uc694\uc6d0 \ub610\ub294\uc804\ubb38\uc5f0\uad6c\uc694\uc6d0 \ub4f1\uc73c\ub85c \ud3b8\uc785 \ub610\ub294 \ud3b8\uc785\uc774 \ucde8\uc18c\ub418\ub294 \ub4f1 \uc2e0\ubd84\uc774 \ubcc0\ub3d9\ub418\uac70\ub098 \ubd84\ud560\ubcf5\ubb34 \ub4f1 \ubcf5\ubb34\uc0ac\ud56d\uc774 \ubcc0\ub3d9\ub418\uc5b4 \ud5c8\uac00\uc694\uac74\uc774 \ub2ec\ub77c\uc9c0\ub294 \uacbd\uc6b0\uc5d0\ub294 \uc601 \uc81c147\uc870\uc7582\uc81c1\ud56d\uc81c5\ud638\uc5d0 \ub530\ub77c \ud5c8\uac00\ub97c \ucde8\uc18c\ud558\uace0 \uadf8 \uc0ac\uc2e4\uc744 \ubcf8\uc778\uc5d0\uac8c \ud1b5\uc9c0\ud558\uc5ec\uc57c\ud55c\ub2e4. \uc774 \uacbd\uc6b0 \ud574\ub2f9 \uc790\uc6d0\uad00\ub9ac\ubd80\uc11c\uc5d0\uc11c\ub294 \uc2e0\ubd84 \ub610\ub294 \ubcf5\ubb34\uc0ac\ud56d \ubcc0\ub3d9 \uc0ac\uc2e4\uc744 \uad6d\uc678\uc5ec\ud589\ud5c8\uac00\ubd80\uc11c\uc5d0 \uc989\uc2dc \ud1b5\ubcf4\ud558\uc5ec\uc57c\ud558\uba70, \uad6d\uc678\uc5ec\ud589\ud5c8\uac00\ubd80\uc11c\ub294 \ud5c8\uac00 \ucde8\uc18c \ucc98\ub9ac\uacb0\uacfc\ub97c \uc790\uc6d0\uad00\ub9ac\ubd80\uc11c\uc5d0 \ud1b5\ubcf4\ud558\uc5ec\uc57c \ud55c\ub2e4."
    },
    {
      "article_no": "125",
      "article_title": "\uc7ac\ud559\uc0dd \uc785\uc601\ub4f1 \uc5f0\uae30",
      "law_name": "\ubcd1\uc5ed\ubc95 \uc2dc\ud589\ub839",
      "paragraph_no": "2",
      "score": 0.4148,
      "text": "[\ubcd1\uc5ed\ubc95 \uc2dc\ud589\ub839 \uc81c125\uc870(\uc7ac\ud559\uc0dd \uc785\uc601\ub4f1 \uc5f0\uae30) \uc81c2\ud56d]\n\u2461 \uc678\uad6d\uc758 \ub300\ud559 \ub610\ub294 \ub300\ud559\uc6d0\uc5d0 \uc7ac\ud559 \uc911\uc778 \uc0ac\ub78c\uc774 \uc81c124\uc870\uc81c1\ud56d\uc5d0 \ub530\ub77c \uc785\uc601\ub4f1\uc758 \uc5f0\uae30\ub97c \uc6d0\ud558\ub294 \uacbd\uc6b0\uc5d0\ub294 \uc785\uc601\ub4f1\uc758\uc5f0\uae30\uc6d0\uc11c(\uc804\uc790\ubb38\uc11c\ub85c \ub41c \uc6d0\uc11c\ub97c \ud3ec\ud568\ud55c\ub2e4)\ub97c \uc9c0\ubc29\ubcd1\ubb34\uccad\uc7a5\uc5d0\uac8c \uc81c\ucd9c\ud574\uc57c \ud55c\ub2e4."
    },
    {
      "article_no": "27",
      "article_title": "\uad6d\uc678\uc774\uc8fc \ubaa9\uc801 \uc678\uc758 \ud5c8\uac00 \ucde8\uc18c",
      "law_name": "\ubcd1\uc5ed\uc758\ubb34\uc790 \uad6d\uc678\uc5ec\ud589 \uc5c5\ubb34\ucc98\ub9ac \uaddc\uc815",
      "paragraph_no": "2",
      "score": 0.3018,
      "text": "[\ubcd1\uc5ed\uc758\ubb34\uc790 \uad6d\uc678\uc5ec\ud589 \uc5c5\ubb34\ucc98\ub9ac \uaddc\uc815 \uc81c27\uc870(\uad6d\uc678\uc774\uc8fc \ubaa9\uc801 \uc678\uc758 \ud5c8\uac00 \ucde8\uc18c) \uc81c2\ud56d]\n\u2461 \uc9c0\ubc29\ubcd1\ubb34\uccad\uc7a5\uc740 \uad6d\uc678\uc5ec\ud589(\uae30\uac04\uc5f0\uc7a5)\ud5c8\uac00 \uae30\uac04 \uc911\uc5d0 \uadc0\uad6d\ud55c \uc0ac\ub78c\uc774 2\uac1c\uc6d4 \uc774\uc0c1 \uacc4\uc18d\ud558\uc5ec \uad6d\ub0b4\uc5d0 \uccb4\uc7ac\ud558\ub294 \uacbd\uc6b0\uc5d0\ub294 \ud5c8\uac00 \ucde8\uc18c\uc5d0 \ub300\ud55c \uc0ac\uc804 \uc548\ub0b4\ub97c \ubcf8\uc778 \ubc0f \uac00\uc871\uc5d0\uac8c \ud558\uc5ec\uc57c \ud558\uba70, 3\uac1c\uc6d4 \uc774\uc0c1 \uacc4\uc18d\ud558\uc5ec \uad6d\ub0b4\uc5d0 \uccb4\uc7ac\ud558\ub294 \uacbd\uc6b0\uc5d0\ub294 \uc601 \uc81c147\uc870\uc7582\uc81c1\ud56d\uc81c3\ud638 \ud6c4\ub2e8\uc5d0 \ub530\ub77c \ud5c8\uac00\ub97c \ucde8\uc18c\ud558\uace0 \uadf8 \uc0ac\uc2e4\uc744 \ubcf8\uc778\uc5d0\uac8c \ud1b5\uc9c0\ud558\uc5ec\uc57c \ud55c\ub2e4."
    }
  ]
}
