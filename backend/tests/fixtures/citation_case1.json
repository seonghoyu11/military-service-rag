    {
      "article_no": "\ubcc4\ud45c3",
      "article_title": "\uad6d\uc678\uc774\uc8fc \ubaa9\uc801\uc758 \uad6d\uc678\uc5ec\ud589\ud5c8\uac00 \ub610\ub294 \uae30\uac04\uc5f0\uc7a5\ud5c8\uac00",
      "law_name": "\ubcd1\uc5ed\ubc95 \uc2dc\ud589\ub839 \ubcc4\ud45c 3",
      "paragraph_no": "1",
      "score": 0.9319,
      "text": "\ubcd1\uc5ed\uc900\ube44\uc5ed, \uc0ac\ud68c\ubcf5\ubb34\uc694\uc6d0 \uc18c\uc9d1\ub300\uc0c1, \ub300\uccb4\ubcf5\ubb34\uc694\uc6d0\uc18c\uc9d1\ub300\uc0c1 \ub300\uc0c1\uc790 \uc911 \uc678\uad6d\uc758 \uc870\uac74\ubd80 \ub610\ub294 \uc784\uc2dc\uc601\uc8fc\uad8c\uc744 \ucde8\ub4dd\ud558\uc5ec \uadf8 \uad6d\uac00\uc5d0\uc11c \uac70\uc8fc\ud558\ub294 \uc0ac\ub78c\uc5d0 \ud574\ub2f9\ud558\ub294 \uc0ac\ub78c\uc740 \uc870\uac74\ubd80 \ub610\ub294 \uc784\uc2dc\uc601\uc8fc\uad8c \uc720\ud6a8\uae30\uac04 \ucd08\uacfc 6\uac1c\uc6d4 \ubc94\uc704 \ub0b4 \ubc94\uc704 \ub0b4\uc5d0\uc11c \uad6d\uc678\uc5ec\ud589\ud5c8\uac00 \ub610\ub294 \uae30\uac04\uc5f0\uc7a5\ud5c8\uac00\ub97c \ubc1b\uc744 \uc218 \uc788\ub2e4. \uad6c\ube44\uc11c\ub958\ub294 \uac00) \uac00\uc871\uac70\uc8fc\uc0ac\uc2e4 \ud655\uc778\uc11c [\uaddc\uce59 \ubcc4\uc9c0 \uc81c133\ud638 \uc11c\uc2dd] * \uc790\ubaa9\uc5d0 \ud574\ub2f9\ud558\ub294 \uc0ac\ub78c\uc774 \uad6d\ub0b4\uc5d0\uc11c \ud5c8\uac00 \uc2e0\uccad\ud55c \uacbd\uc6b0 \uc0dd\ub7b5 \uac00\ub2a5 \ub098) \uccb4\ub958\uc790\uaca9(\ud5c8\uac00\uc11c) \uc0ac\ubcf8 * \ubc14\ubaa9\uc758 \uacbd\uc6b0 \uc0dd\ub7b5 \uac00\ub2a5 \ub2e4) \uac1c\uc778\uc815\ubcf4 \uc81c\uacf5 \ub3d9\uc758\uc11c [\ubcc4\uc9c0 \uc81c11\ud638 \uc11c\uc2dd] * \ubc14\ubaa9\uc758 \uacbd\uc6b0\ub9cc \ud574\ub2f9 \ub77c) \uae30\ud0c0 \uad6d\uc678\uac70\uc8fc \uc0ac\uc2e4\uc744 \uc99d\uba85\ud560 \uc218 \uc788\ub294 \uc11c\ub958 * \uc9c0\ubc29\ubcd1\ubb34\uccad\uc7a5\uc774 \uc0ac\uc2e4 \ud655\uc778\uc744 \uc704\ud574 \ud544\uc694\ud558\ub2e4\uace0 \uc778\uc815\ud558\ub294 \uacbd\uc6b0\uc774\ub2e4."
    }
  ]
